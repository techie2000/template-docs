{
  "[jsonc]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "chat.agent.maxRequests": 35,
  "chat.agent.sandbox.retryWithAllowNetworkRequests": true,
  "chat.math.enabled": true,
  "chat.mcp.autostart": "onlyNew",
  "chat.mcp.discovery.enabled": {
    "claude-desktop": true,
    "cursor-global": true,
    "cursor-workspace": true,
    "windsurf": true
  },
  "chat.sessionSync.enabled": true,
  "chat.tools.terminal.autoApprove": {
    ".vscode/settings.json": true,
    "/^node --test(\\s+.*)?$/": {
      "approve": true,
      "matchCommandLine": true
    },
    "ConvertFrom-Json": true,
    "ConvertTo-Json": true,
    "ForEach-Object": true,
    "gh": true,
    "git add": true,
    "git checkout": true,
    "git cherry-pick": true,
    "git commit": true,
    "git push": true,
    "git restore": true,
    "git rev-parse": true,
    "make": true,
    "mkdir": true,
    "New-Item": true,
    "npm ci": true,
    "npm pkg": true,
    "Out-Null": true,
    "Set-Content": true,
    "Test-Path": true
  },
  "chat.tools.urls.autoApprove": {
    "https://code.visualstudio.com": true,
    "https://documenter.getpostman.com": true,
    "https://github.com": {
      "approveRequest": true,
      "approveResponse": true
    },
    "https://github.com/microsoft/vscode/wiki/*": true,
    "https://pkg.go.dev": true,
    "https://raw.githubusercontent.com": {
      "approveRequest": true,
      "approveResponse": true
    }
  },
  "chat.useAgentSkills": true,
  "chat.useCustomizationsInParentRepositories": true,
  "chat.viewSessions.orientation": "stacked",
  "chatCustomizationsEvaluations.customDiagnostics": [],
  "code-eol.highlightExtraWhitespace": true,
  "code-eol.highlightNonDefault": true,
  "cSpell.allowCompoundWords": false,
  "cSpell.autocorrect": false,
  "cSpell.caseSensitive": true,
  "cSpell.customDictionaries": {
    "finance-words": {
      "addWords": true,
      "description": "Finance-domain accepted words",
      "name": "finance-words",
      "path": "${workspaceFolder}/.vscode/finance-words.txt",
      "scope": "workspace"
    },
    "generic-project-words": {
      "addWords": true,
      "description": "Project-specific accepted words",
      "name": "generic-project-words",
      "path": "${workspaceFolder}/.vscode/generic-project-words.txt",
      "scope": "workspace"
    },
    "it-words": {
      "addWords": true,
      "description": "IT and tooling accepted words",
      "name": "it-words",
      "path": "${workspaceFolder}/.vscode/it-words.txt",
      "scope": "workspace"
    }
  },
  "cSpell.enabled": true,
  "cSpell.enabledFileTypes": {
    "json": true,
    "jsonc": true,
    "makefile": false,
    "markdown": true,
    "plaintext": true,
    "shellscript": false,
    "yaml": true,
    "powershell": false
  },
  "cSpell.ignoreRegExpList": [],
  "cSpell.language": "en,en-GB",
  "csv.enabled": true,
  "diffEditor.diffAlgorithm": "advanced",
  "diffEditor.ignoreTrimWhitespace": false,
  "editor.autoClosingBrackets": "languageDefined",
  "editor.inlineSuggest.edits.showCollapsed": true,
  "editor.renderControlCharacters": false,
  "editor.renderWhitespace": "all",
  "editor.showFoldingControls": "always",
  "favorites.saveSeparated": true,
  "files.exclude": {
    "**/backups/**": true,
    "**/worktrees/**": true
  },
  "files.watcherExclude": {
    "**/backups/**": true,
    "**/worktrees/**": true
  },
  "git.autofetch": true,
  "github.copilot.chat.anthropic.cacheBreakpoints.lastTwoMessages": true,
  "github.copilot.chat.anthropic.tools.websearch.enabled": true,
  "github.copilot.chat.anthropic.tools.websearch.userLocation": {},
  "github.copilot.chat.cli.remote.enabled": true,
  "github.copilot.chat.codesearch.enabled": true,
  "github.copilot.chat.copilotMemory.enabled": true,
  "github.copilot.chat.githubMcpServer.enabled": true,
  "github.copilot.chat.localIndex.enabled": true,
  "github.copilot.chat.responsesApi.toolSearchTool.enabled": true,
  "github.copilot.chat.reviewSelection.instructions": [
    {
      "text": "Please review the following code for potential issues and improvements."
    }
  ],
  "github.copilot.chat.skillTool.enabled": true,
  "github.copilot.chat.switchAgent.enabled": true,
  "github.copilot.nextEditSuggestions.enabled": true,
  "gitlab.customQueries": [
    {
      "name": "Issues assigned to me",
      "noItemText": "No issues assigned to you.",
      "scope": "assigned_to_me",
      "state": "opened",
      "type": "issues"
    },
    {
      "name": "Issues created by me",
      "noItemText": "No issues created by you.",
      "scope": "created_by_me",
      "state": "opened",
      "type": "issues"
    },
    {
      "name": "Merge requests assigned to me",
      "noItemText": "No merge requests assigned to you.",
      "scope": "assigned_to_me",
      "state": "opened",
      "type": "merge_requests"
    },
    {
      "name": "Merge requests I'm reviewing",
      "noItemText": "No merge requests for you to review.",
      "reviewer": "<current_user>",
      "state": "opened",
      "type": "merge_requests"
    },
    {
      "name": "Merge requests created by me",
      "noItemText": "No merge requests created by you.",
      "scope": "created_by_me",
      "state": "opened",
      "type": "merge_requests"
    },
    {
      "name": "All project merge requests",
      "noItemText": "The project has no merge requests",
      "scope": "all",
      "state": "opened",
      "type": "merge_requests"
    }
  ],
  "gitlab.real-timeSecurityScan.enabled": true,
  "gitlab.showPipelineUpdateNotifications": true,
  "imageCarousel.explorerContextMenu.enabled": true,
  "inlineChat.notebookAgent": true,
  "logViewer.chunkSizeKb": 64,
  "logViewer.followTailMode": "auto",
  "logViewer.logLevel": "error",
  "logViewer.options": {
    "encoding": "utf8",
    "fileCheckInterval": 500,
    "fileListInterval": 2000,
    "ignorePattern": "(node_modules|.git)"
  },
  "logViewer.showStatusBarItemOnChange": true,
  "makefile.configureOnOpen": true,
  "markdown-mermaid.controls.show": "always",
  "markdownlint.configFile": ".markdownlint-cli2.yaml",
  "markdownlint.lintWorkspaceGlobs": [
    "**/*.md",
    "!**/.tmp/**"
  ],
  "notebook.showFoldingControls": "always",
  "search.exclude": {
    "**/backups/**": true,
    "**/worktrees/**": true
  },
  "terminal.integrated.localEchoEnabled": "auto",
  "terminal.integrated.suggest.enabled": true,
  "terminal.integrated.suggest.providers": {
    "lsp": true
  },
  "terminal.integrated.suggest.quickSuggestions": {
    "arguments": "on",
    "commands": "on"
  },
  "terminal.integrated.windowsUseConptyDll": true,
  "win-ca.inject": "append",
  "workbench.browser.enableChatTools": true,
  "workbench.browser.experimentalUserTools.enabled": true,
  "workbench.colorTheme": "Copilot Theme"
}
